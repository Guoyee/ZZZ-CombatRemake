# ===== IDE / Tools =====
.vs/
.idea/

# Claude Code local overrides (machine-specific)
.claude/settings.local.json

# User-specific IDE settings (Rider / VS)
*.DotSettings.user

# ===== Compiled artifacts =====
*.obj
*.pch
*.gch
*.dll
*.lib
*.exe

# ===== Project files generated by the engine / VS =====
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# ===== UE generated directories =====
Binaries/*
# Local dev-only plugins (UE_MCP_Bridge / RiderLink) — install manually
Plugins/
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico
Saved/*
Intermediate/*
DerivedDataCache/*

# Built data for maps
*_BuiltData.uasset

# Engine-generated user settings
Config/GameUserSettings.ini

# Content — only the ZZZ module is tracked
# (Variant_* templates / ThirdPerson samples / personal Developers folder are regenerable)
Content/*
!Content/ZZZ/

# Source animation files (FBX source art, not imported into the project)
model/

# Python tool caches (root-level tooling scripts)
__pycache__/
*.pyc
