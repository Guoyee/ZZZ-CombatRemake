## 八、ZZZCharacter 修改

### 8.1 头文件新增

```cpp
// ZZZCharacter.h 新增:

class UZZZInputConfig;

// 替代旧的 AttackAction + AttackAbility:
UPROPERTY(EditDefaultsOnly, Category = "Input")
TObjectPtr<UZZZInputConfig> InputConfig;

UPROPERTY(EditDefaultsOnly, Category = "GAS")
TArray<TSubclassOf<UGameplayAbility>> DefaultAbilities;

void Input_AbilityInputTagPressed(FGameplayTag InputTag);
void Input_AbilityInputTagReleased(FGameplayTag InputTag);
```

### 8.2 实现文件修改

```cpp
void AZZZCharacter::SetupPlayerInputComponent(UInputComponent* PlayerInputComponent)
{
    Super::SetupPlayerInputComponent(PlayerInputComponent);

    UEnhancedInputComponent* EI = CastChecked<UEnhancedInputComponent>(PlayerInputComponent);

    // 保留 Move/Look 绑定
    EI->BindAction(MoveAction, ETriggerEvent::Triggered, this, &AZZZCharacter::Move);
    EI->BindAction(MouseLookAction, ETriggerEvent::Triggered, this, &AZZZCharacter::Look);
    EI->BindAction(LookAction, ETriggerEvent::Triggered, this, &AZZZCharacter::Look);

    // 数据驱动的能力输入绑定（替代旧的手写 AttackPressed）
    if (InputConfig)
    {
        for (const FZZZInputAction& Action : InputConfig->AbilityInputActions)
        {
            EI->BindAction(Action.InputAction, ETriggerEvent::Triggered,
                this, &AZZZCharacter::Input_AbilityInputTagPressed, Action.InputTag);
            EI->BindAction(Action.InputAction, ETriggerEvent::Completed,
                this, &AZZZCharacter::Input_AbilityInputTagReleased, Action.InputTag);
        }
    }
}

void AZZZCharacter::Input_AbilityInputTagPressed(FGameplayTag InputTag)
{
    if (!ASC) return;

    // 1. 广播 GameplayEvent（供 AbilityTask_WaitInputBuffer 等 Task 监听）
    FGameplayEventData EventData;
    EventData.Instigator = this;
    ASC->HandleGameplayEvent(InputTag, &EventData);

    // 2. 通过 Tag 激活匹配的 Ability（Ability.Triggers 中配置相同 Tag）
    ASC->TryActivateAbilitiesByTag(FGameplayTagContainer(InputTag));
}

void AZZZCharacter::Input_AbilityInputTagReleased(FGameplayTag InputTag)
{
    if (!ASC) return;
    // 通知 ASC 释放 Input Tag（蓄力攻击等需要 Released 事件的场景）
    ASC->NotifyAbilityInputReleased(InputTag);
}

void AZZZCharacter::AddCharacterAbilities()
{
    // 批量授予 DefaultAbilities 中的所有 Ability
    for (const TSubclassOf<UGameplayAbility>& AbilityClass : DefaultAbilities)
    {
        if (AbilityClass)
        {
            ASC->GiveAbility(FGameplayAbilitySpec(AbilityClass));
        }
    }
}
```

**移除的代码**：
- `AZZZCharacter::AttackPressed()` — 被 `Input_AbilityInputTagPressed` 替代
- `AZZZCharacter::AttackAbility` (TSubclassOf) — 被 `DefaultAbilities` (TArray) 替代

